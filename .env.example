# GENERAL
PORT= //port number for the server to listen on
LOG_DIRECTORY= //directory where logs will be stored
NODE_ENV= //environment the application is running in (development, production, etc.)

# TOKEN CONFIG
ACCESS_TOKEN_VALIDITY_SEC= //validity period of the access token in seconds
REFRESH_TOKEN_VALIDITY_SEC= //validity period of the refresh token in seconds
JWT_ISSUER= //issuer of the JWT token
JWT_AUDIENCE= //audience of the JWT token
JWT_SECRET= //secret key used for signing the JWT token
JWT_ALGORITHM= //algorithm used for signing the JWT token (e.g., HS256, RS256)


# REDIS
REDIS_URL= //Redis url
DB_URL= //database url

# RESEND
RESEND_API_KEY= //API key for RESEND service
RESEND_CONTACT_EMAIL= //email address used as the contact/sender for RESEND messages

# QBOT - AI Chatbot Configuration
Qbot_LLM_PROVIDER= //LLM provider (openai, anthropic)
Qbot_LLM_API_KEY= //API key for the LLM provider
Qbot_LLM_MODEL= //Model name (e.g., gpt-4o, claude-3-5-sonnet-20241022)
Qbot_LLM_TEMPERATURE= //Temperature for LLM (0-2, default 0.7)
Qbot_LLM_MAX_TOKENS= //Max tokens for response (default 4000)
Qbot_LLM_TIMEOUT_MS= //LLM request timeout in milliseconds (default 60000)
Qbot_LLM_MAX_RETRIES= //Provider retries (default 2)
Qbot_MAX_HISTORY_MESSAGES= //Recent messages sent as verbatim context (default 20)
Qbot_SUMMARY_THRESHOLD= //Unsummarized messages before a new summary is written (default 16)
Qbot_RECENT_MESSAGES_KEEP= //Recent messages left out of the summary (default 6)
Qbot_RATE_LIMIT_MAX= //Message requests allowed per window (default 30)
Qbot_RATE_LIMIT_WINDOW_SEC= //Rate-limit window in seconds (default 60)