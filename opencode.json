{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["agent.md"],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "logs/**",
      "src/generated/**",
      ".git/**"
    ]
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*node_modules/*": "deny",
      "*dist/*": "deny",
      "*build/*": "deny",
      "*coverage/*": "deny",
      "logs/*": "deny",
      "*.log": "deny",
      "*.log.gz": "deny",
      "*pnpm-lock.yaml": "deny",
      "*package-lock.json": "deny"
    },
    "edit": {
      "*": "allow",
      "src/generated/*": "deny",
      "*pnpm-lock.yaml": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "*node_modules*": "deny",
      "*pnpm-lock.yaml*": "deny"
    }
  }
}
